{
  "name": "midnight-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "contract:compile": "npm run compact --workspace @payroll/midnight-contract && npm run sync:zk",
    "contract:test": "npm test --workspace @payroll/midnight-contract",
    "sync:zk": "node scripts/sync-zk-assets.mjs",
    "cardano:build": "cd contracts/cardano && aiken build",
    "cardano:test": "cd contracts/cardano && aiken check",
    "cardano:test:offchain": "tsx scripts/test-cardano-reserve.ts",
    "chain:test:local": "tsx scripts/test-local-backend.mts",
    "prebuild": "node scripts/sync-zk-assets.mjs",
    "predev": "node scripts/sync-zk-assets.mjs"
  },
  "dependencies": {
    "@meshsdk/core": "1.9.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "buffer": "6.0.3",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.554.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "7.8.2",
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@meshsdk/core-csl": "1.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "7.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5"
  },
  "workspaces": [
    "contracts/midnight",
    "contracts/cardano"
  ]
}
