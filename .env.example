# Copy to .env.local to override the defaults.

# Midnight network the Lace wallet should connect to.
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preprod
# Used only if the wallet does not provide its own proving provider.
NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300
# Pin a deployed payroll contract so every browser joins the same one.
NEXT_PUBLIC_PAYROLL_CONTRACT=

# Cardano network for the reserve escrow.
NEXT_PUBLIC_CARDANO_NETWORK=preprod
# Optional: use Blockfrost instead of the public Koios endpoint.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
